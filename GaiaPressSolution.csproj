<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- Supprimez ces lignes si vous ne les utilisez pas -->
		<DockerDefaultTargetOS>Windows</DockerDefaultTargetOS>
		<DockerfileContext>.</DockerfileContext>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="GaiaPressWeb\**" />
	  <Content Remove="GaiaPressWeb\**" />
	  <EmbeddedResource Remove="GaiaPressWeb\**" />
	  <None Remove="GaiaPressWeb\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="GaiaPressWeb.vbproj.user" />
	</ItemGroup>

	<ItemGroup>
		<!-- Seuls les packages spécifiques à votre projet -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
		<!-- Si vous utilisez Razor (pour les vues) -->
		<!-- <PackageReference Include="Microsoft.AspNetCore.Razor" Version="8.0.0" /> -->
	</ItemGroup>

</Project>