<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GaiaPressWeb</RootNamespace>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StartUpGaiaPressWeb.vb" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Chart.js" Version="3.7.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <!-- ✅ Supprimez la section <ItemGroup> ci-dessous -->
  <!-- Elle est inutile et cause des doublons -->
  <!--
  <ItemGroup>
    <Content Include="wwwroot\**\*.*" />
  </ItemGroup>
  -->

</Project>