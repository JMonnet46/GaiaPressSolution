@page "/Borehole"
@page "/Borehole/{RefChantier?}"
@rendermode InteractiveServer

@using GaiaPressCoreV17.Services
@using GaiaPressCoreV17.Models
@using GaiaPressBlazorWebAPP.Components.Borehole
@using GaiaPressBlazorWebAPP.Services
@using ForageModel = GaiaPressCoreV17.Models.Forage
@using GaiaPressBlazorWebAPP.Components.Test
@implements IDisposable

@inject NavigationManager Navigation
@inject LocalizationService Loc
@inject IForageService ForageService
@inject ChantierState ChantierState
@inject IJSRuntime JS

<PageTitle>@Loc["Borehole"]</PageTitle>

<div class="container-fluid mt-3">
    @if (!string.IsNullOrWhiteSpace(RefChantier))
    {
        <p>Chantier actif : @RefChantier</p>
    }

    @if (isInitializing)
    {
        <p><em>@Loc["Loading"]</em></p>
    }
    else if (isCreating)
    {
        @if (string.IsNullOrWhiteSpace(RefChantier))
        {
            <div class="alert alert-warning" role="alert">
                @Loc["SelectChantierFirst"]
                <div class="mt-3">
                    <a href="/ConstructionSite" class="btn btn-secondary">@Loc["GoToConstructionSite"]</a>
                </div>
            </div>
        }
        else
        {
            <ForageForm RefChantier="@RefChantier"
                        RefForage="@refForage"
                        OnSaved="OnForageSaved"
                        OnCancel="OnForageCancelled" />
        }
    }
    else if (selectedBorehole == null)
    {
        @if (string.IsNullOrWhiteSpace(RefChantier))
        {
            <div class="alert alert-warning" role="alert">
                <strong>@Loc["SelectChantierFirst"]</strong>
                <div class="mt-3">
                    <a href="/ConstructionSite" class="btn btn-secondary">@Loc["GoToConstructionSite"]</a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3>@Loc["Boreholes"] - @RefChantier</h3>
                <button type="button" class="btn btn-primary" @onclick="CreateBorehole">@Loc["AddBorehole"]</button>
            </div>

            @if (isLoadingForages)
            {
                <p><em>@Loc["Loading"]</em></p>
            }
            else if (forages.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>@Loc["BoreholeReference"]</th>
                            <th>@Loc["BoreholeName"]</th>
                            <th>@Loc["BoreholeNumber"]</th>
                            <th>@Loc["BoreholeDate"]</th>
                            <th>@Loc["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in forages)
                        {
                            <tr>
                                <td>@f.RefForage</td>
                                <td>@f.NomForage</td>
                                <td>@f.numeroForage</td>
                                <td>@f.dateForage.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" @onclick="() => SelectForage(f)">@Loc["Select"]</button>
                                    <button type="button" class="btn btn-sm btn-outline-warning me-1" @onclick="() => EditForage(f)">@Loc["Modify"]</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteForage(f.RefForage)">@Loc["Delete"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">@Loc["NoBoreholesForChantier"]</div>
            }
        }
    }
    else
    {
        <h3>@Loc["Borehole"]: @selectedBorehole.RefForage</h3>

        <div class="mb-3">
            <button type="button" class="btn btn-secondary me-2" @onclick="BackToList">@Loc["BackToList"]</button>
            <button type="button" class="btn btn-warning" @onclick="EditBorehole">@Loc["Modify"]</button>
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button type="button" class="nav-link @(activeTab == "Borehole" ? "active" : "")" @onclick='() => SetTab("Borehole")'>@Loc["Borehole"]</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(activeTab == "Test" ? "active" : "")" @onclick='() => SetTab("Test")'>@Loc["Test"]</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(activeTab == "Probe" ? "active" : "")" @onclick='() => SetTab("Probe")'>@Loc["Probe"]</button></li>
            <li class="nav-item"><button type="button" class="nav-link @(activeTab == "Soil" ? "active" : "")" @onclick='() => SetTab("Soil")'>@Loc["Soil"]</button></li>
        </ul>

        <div class="tab-content">
            @if (activeTab == "Borehole")
            {
                <div class="alert alert-info">
                    <strong>@Loc["BoreholeDetails"]:</strong> @selectedBorehole.RefForage - @selectedBorehole.NomForage
                </div>
            }
            else if (activeTab == "Test")
            {
                @if (ouvrirNouvelEssai)
                {
                    <NewTest
                        RefChantier="@RefChantier"
                        RefForage="@selectedBorehole.RefForage"
                        OnClose="CloseNewTest" />
                }
                else
                {
                    <button type="button" class="btn btn-primary mb-3"
                            @onclick="@(e => Navigation.NavigateTo($"/NewTest/{selectedBorehole?.RefForage}"))">
                        @Loc["NewTest"]
                    </button>
                }
            }
            else if (activeTab == "Probe")
            {
                <div class="alert alert-info">@Loc["ProbesComing"] (Ref: @selectedBorehole.RefForage)</div>
            }
            else if (activeTab == "Soil")
            {
                <div class="alert alert-info">@Loc["SoilsComing"] (Ref: @selectedBorehole.RefForage)</div>
            }
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="button" class="btn btn-secondary" @onclick="Close">@Loc["Close"]</button>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-2" role="alert">@message</div>
        }
    }
</div>

@code {
    [Parameter] public string RefChantier { get; set; } = "";
    private ForageModel? selectedBorehole;
    private List<ForageModel> forages = new();
    private string? refForage;
    private bool isCreating;
    private bool isInitializing = true;
    private bool isLoadingForages;
    private bool ouvrirNouvelEssai = false;
    private string activeTab = "Borehole";
    private bool isError;
    private string message = "";

    private void CloseNewTest()
    {
        ouvrirNouvelEssai = false;
        StateHasChanged();
    }

    private async Task LoadForages()
    {
        if (string.IsNullOrWhiteSpace(RefChantier)) return;
        isLoadingForages = true;
        try
        {
            var allForages = await ForageService.GetAllForagesAsync();
            forages = allForages?.Where(f => string.Equals(f.RefChantier, RefChantier, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
        }
        catch (Exception ex)
        {
            message = $"Erreur: {ex.Message}";
            isError = true;
        }
        finally { isLoadingForages = false; }
    }

    private async Task SelectForage(ForageModel forage)
    {
        selectedBorehole = forage;
        activeTab = "Borehole";
        ouvrirNouvelEssai = false;
        await JS.InvokeVoidAsync("localStorage.setItem", "selectedBorehole",
            System.Text.Json.JsonSerializer.Serialize(forage));
    }

    private async Task BackToList()
    {
        selectedBorehole = null;
        ouvrirNouvelEssai = false;
        await JS.InvokeVoidAsync("localStorage.removeItem", "selectedBorehole");
        await LoadForages();
    }

    protected override void OnInitialized()
    {
        ChantierState.OnChange += HandleChantierChanged;
        if (!string.IsNullOrWhiteSpace(RefChantier))
            ChantierState.SetChantier(RefChantier);
        else
            RefChantier = ChantierState.RefChantier;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(RefChantier))
            ChantierState.SetChantier(RefChantier);
        else
            RefChantier = ChantierState.RefChantier;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (string.IsNullOrWhiteSpace(RefChantier))
            {
                var stored = await JS.InvokeAsync<string>("localStorage.getItem", "selectedChantier");
                RefChantier = ExtractRefChantier(stored);
            }
            if (!string.IsNullOrWhiteSpace(RefChantier))
                await LoadForages();
        }
        catch (Exception ex)
        {
            message = $"Erreur initialisation: {ex.Message}";
            isError = true;
        }
        finally
        {
            isInitializing = false;
            StateHasChanged();
        }
    }

    private static string? ExtractRefChantier(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(value);
            var root = document.RootElement;
            if (root.ValueKind == System.Text.Json.JsonValueKind.String)
                return root.GetString();
            if (root.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var property in root.EnumerateObject())
                    if (string.Equals(property.Name, "RefChantier", StringComparison.OrdinalIgnoreCase) && property.Value.ValueKind == System.Text.Json.JsonValueKind.String)
                        return property.Value.GetString();
            }
        }
        catch (System.Text.Json.JsonException)
        {
            return value.Trim();
        }
        return null;
    }

    private void HandleChantierChanged()
    {
        if (string.IsNullOrWhiteSpace(RefChantier))
            RefChantier = ChantierState.RefChantier;
        _ = InvokeAsync(async () =>
        {
            selectedBorehole = null;
            ouvrirNouvelEssai = false;
            await LoadForages();
            StateHasChanged();
        });
    }

    private void CreateBorehole()
    {
        isCreating = true;
        refForage = null;
        selectedBorehole = null;
    }

    private void EditForage(ForageModel forage)
    {
        isCreating = true;
        refForage = forage.RefForage;
        selectedBorehole = null;
    }

    private void EditBorehole()
    {
        isCreating = true;
        refForage = selectedBorehole?.RefForage;
        RefChantier ??= selectedBorehole?.RefChantier;
    }

    private void OnForageCancelled()
    {
        isCreating = false;
        refForage = null;
    }

    private async Task DeleteForage(string refForage)
    {
        if (string.IsNullOrWhiteSpace(refForage))
            return;

        var confirm = await JS.InvokeAsync<bool>("confirm", $"Supprimer le forage {refForage} ?");
        if (!confirm)
            return;

        try
        {
            await ForageService.DeleteForageAsync(refForage);
            message = "Forage supprimé avec succès.";
            isError = false;
            await LoadForages();
        }
        catch (Exception ex)
        {
            message = $"Erreur suppression: {ex.Message}";
            isError = true;
        }
    }

    private async Task OnForageSaved(ForageModel savedForage)
    {
        isCreating = false;
        selectedBorehole = null;
        message = "Forage enregistré avec succès.";
        isError = false;
        await LoadForages();
        StateHasChanged();
    }

    private void SetTab(string tab) => activeTab = tab;

    private void Close() => Navigation.NavigateTo("/ConstructionSite");

    public void Dispose() => ChantierState.OnChange -= HandleChantierChanged;
}