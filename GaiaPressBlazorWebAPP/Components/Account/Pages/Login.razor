@page "/Account/Login"
@using System.ComponentModel.DataAnnotations
@using GaiaPressBlazorWebAPP.Services
@using GaiaPressBlazorWebAPP.Components.Account.Shared

@inject AuthService AuthService
@inject NavigationManager NavigationManager

@inject ConnectionService ConnectionService
@inject IConfiguration Configuration

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<div class="row">
    <div class="col-md-4">
        <StatusMessage Message="@errorMessage" IsError="true" />

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <h2>Utilisez un compte local pour vous connecter.</h2>
            <hr />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.UserName" class="form-control" autocomplete="username" aria-required="true" placeholder="admin_gaia" />
                <label for="username">Nom d'utilisateur</label>
                <ValidationMessage For="() => Input.UserName" class="text-danger" />
            </div>

            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="mot de passe" />
                <label for="password">Mot de passe</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>

            <div class="form-check mb-3">
                <InputCheckbox @bind-Value="Input.RememberMe" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe">
                    Se souvenir de moi (ne plus demander le mot de passe)
                </label>
            </div>

            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Se connecter</button>
            </div>

            <hr />

            <div class="mt-3">
                <p>
                    <a href="Account/ForgotPassword" class="text-decoration-none">
                        🔑 Mot de passe oublié ? / Changer le mot de passe
                    </a>
                </p>
                <p>
                    <a href="Account/Register" class="text-decoration-none">
                        👤 S'inscrire comme nouvel utilisateur
                    </a>
                </p>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private string? errorMessage;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    public async Task LoginUser()
    {
        // Vérification des identifiants
        if (Input.UserName == "admin_gaia" && Input.Password == "Carl@07092026")
        {
            // 1. Connexion à l'application (session)
            await AuthService.LoginAsync(Input.UserName, Input.RememberMe);

            // 2. CONNEXION AUTOMATIQUE À LA BASE DE DONNÉES (NOUVEAU)
            try
            {
                var connStr = Configuration.GetConnectionString("DefaultConnection");
                if (!string.IsNullOrEmpty(connStr))
                {
                    ConnectionService.SetConnection(connStr, Input.UserName);
                    Console.WriteLine($"[Login] Connexion BD établie pour {Input.UserName}");
                }
                else
                {
                    Console.WriteLine("[Login] ERREUR: Connection string 'DefaultConnection' est vide!");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Login] ERREUR connexion BD: {ex.Message}");
                // On continue quand même, l'utilisateur pourra se connecter manuellement à la BD
            }

            NavigationManager.NavigateTo(ReturnUrl ?? "/");
        }
        else
        {
            errorMessage = "Erreur : Nom d'utilisateur ou mot de passe incorrect.";
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Le nom d'utilisateur est requis")]
        [Display(Name = "Nom d'utilisateur")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Le mot de passe est requis")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Se souvenir de moi")]
        public bool RememberMe { get; set; } = false;
    }
}