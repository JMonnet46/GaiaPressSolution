@page "/NewTest/{RefForage}"
@rendermode InteractiveServer
@implements IDisposable
@using GaiaPressBlazorWebAPP.Models
@using GaiaPressBlazorWebAPP.Services
@using GaiaPressCoreV17.Data
@using Microsoft.EntityFrameworkCore
@inject NavigationManager Navigation
@inject LocalizationService Loc
@inject IDbContextFactory<GaiaPress_Db_Context> DbFactory

<PageTitle>@Loc["PageTitle"] - @test.Reference</PageTitle>

<div class="container-fluid mt-3">
    <h4>@Loc["DetailEssai"] : @test.Reference</h4>

    @if (!string.IsNullOrEmpty(MessageErreur))
    {
        <div class="alert alert-danger">@MessageErreur</div>
    }
    @if (!string.IsNullOrEmpty(MessageSucces))
    {
        <div class="alert alert-success">@MessageSucces</div>
    }

    <div class="row">
        <!-- COLONNE GAUCHE -->
        <div class="col-md-6">

            <fieldset class="border p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">@Loc["IdentificationEssai"]</legend>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["RefEssaiLabel"]</label>
                    <div class="col-7">
                        <input class="form-control" @bind="test.Reference" placeholder="@Loc["RefEssaiPlaceholder"]" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["NomEssaiLabel"]</label>
                    <div class="col-7">
                        <input class="form-control" @bind="test.NomEssai" placeholder="@Loc["NomEssaiPlaceholder"]" />
                    </div>
                </div>
            </fieldset>

            <fieldset class="border p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">@Loc["RealisationEssai"]</legend>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["DateEssaiLabel"]</label>
                    <div class="col-7"><input type="date" class="form-control" @bind="test.DateEssai" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["HeureEssaiLabel"]</label>
                    <div class="col-7"><input type="time" step="1" class="form-control" @bind="test.HeureEssai" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["DiffPressionLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.DiffPression" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["HauteurControleurLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.HauteurControleur" /></div>
                </div>
            </fieldset>

            <fieldset class="border p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">@Loc["ConditionsGeoLabel"]</legend>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["P0Label"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control bg-light" value="@test.P0" readonly />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["ProfondeurNappeLabel"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control" @bind="test.ProfondeurNappe" @bind:after="Recalculer" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["ProfondeurSondeLabel"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control" @bind="test.ProfondeurSonde" @bind:after="Recalculer" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PoidsVolumiqueLabel"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control" @bind="test.PoidsVolumique" @bind:after="Recalculer" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PoidsVolumiqueDejaugeLabel"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control" @bind="test.PoidsVolumiqueDejauge" @bind:after="Recalculer" />
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["CoefficientPoissonLabel"]</label>
                    <div class="col-7">
                        <input type="number" step="any" class="form-control" @bind="test.CoefficientPoisson" @bind:after="Recalculer" />
                    </div>
                </div>
            </fieldset>
        </div>

        <!-- COLONNE DROITE -->
        <div class="col-md-6">

            <fieldset class="border p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">@Loc["EnregistreurOperateurLabel"]</legend>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["EnregistreurLabel"]</label>
                    <div class="col-7"><input class="form-control" @bind="test.Enregistreur" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["OperateurLabel"]</label>
                    <div class="col-7"><input class="form-control" @bind="test.Operateur" /></div>
                </div>
            </fieldset>

            <fieldset class="border p-3 mb-3">
                <legend class="float-none w-auto px-2 fs-6">@Loc["PrecisionLabel"]</legend>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["ClassePrecisionLabel"]</label>
                    <div class="col-7">
                        <select class="form-select" @bind="test.ClassePrecision">
                            <option value="A">A</option>
                            <option value="B">B</option>
                            <option value="C">C</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionLongueurLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionLongueur" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionDiametreLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionDiametre" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionPressionLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionPression" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionEpaisseurLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionEpaisseur" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionVolumeLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionVolume" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionPoidsVolLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionPoidsVol" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionProfondeurLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionProfondeur" /></div>
                </div>
                <div class="row mb-2">
                    <label class="col-5 col-form-label">@Loc["PrecisionTempsLabel"]</label>
                    <div class="col-7"><input type="number" step="any" class="form-control" @bind="test.PrecisionTemps" /></div>
                </div>
            </fieldset>
        </div>
    </div>

    <div class="mb-3">
        <button class="btn btn-danger me-2" @onclick="Supprimer">@Loc["SupprimerButton"]</button>
        <button class="btn btn-primary me-2" @onclick="Modifier">@Loc["ModifierButton"]</button>
        <button class="btn btn-success me-2" @onclick="Valider">@Loc["SubmitButton"]</button>
        <button class="btn btn-secondary" @onclick="Annuler">@Loc["AnnulerButton"]</button>
    </div>

    <hr />
    <div class="row">
        <div class="col-4">@Loc["NomChantierLabel"] : <strong>@ChantierAssocie</strong></div>
        <div class="col-4">@Loc["NomForageLabel"] : <strong>@NomForage</strong></div>
        <div class="col-4 text-end">
            <button class="btn btn-outline-primary me-2" @onclick="Enregistrer">@Loc["EnregistrerButton"]</button>
            <button class="btn btn-outline-secondary me-2" @onclick="Imprimer">@Loc["ImprimerButton"]</button>
            <button class="btn btn-outline-dark" @onclick="Fermer">@Loc["FermerButton"]</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string RefForage { get; set; } = "";
    [Parameter] public string? RefEssai { get; set; }

    // Chantier associé : à alimenter (paramètre, service ou session) selon votre logique existante
    private string ChantierAssocie { get; set; } = "";

    private TestDetailModel test = new();
    private string NomForage => RefForage;

    private string? MessageErreur;
    private string? MessageSucces;

    private bool EstFrancais => Loc.CurrentLanguage == "fr-FR" || Loc.CurrentLanguage == "fr";

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Loc.LanguageChanged -= OnLanguageChanged;

    protected override void OnInitialized()
    {
        Loc.LanguageChanged += OnLanguageChanged;

        test.NomEssai = "SP1_1";
        test.DateEssai = DateTime.Today;
        test.HeureEssai = DateTime.Now;
        test.ClassePrecision = "B";

        Recalculer();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(RefEssai) && test.Reference != RefEssai)
        {
            test.Reference = RefEssai;
        }
    }

    // ================= CALCUL P0 =================
    private void Recalculer()
    {
        Journal("Recalcul P0 - début");

        double Z = test.ProfondeurSonde;
        double Zw = test.ProfondeurNappe;
        double Gamma = test.PoidsVolumique;
        double GammaP = test.PoidsVolumiqueDejauge;
        double Nu = test.CoefficientPoisson;

        double sigmaz = Zw >= Z
            ? Gamma * Z
            : Gamma * Zw + GammaP * (Z - Zw);

        Journal($"Sigmaz = {sigmaz:F2} kPa (Z={Z}, Zw={Zw}, Gamma={Gamma}, GammaP={GammaP})");

        if (sigmaz <= 0)
        {
            MessageErreur = EstFrancais
                ? "La contrainte verticale est négative ou nulle"
                : "The vertical stress is null or negative";
            test.P0 = 0;
            return;
        }

        if (Nu >= 1)
        {
            MessageErreur = EstFrancais
                ? "Le coefficient de Poisson doit être inférieur à 1"
                : "Poisson's ratio must be less than 1";
            test.P0 = 0;
            return;
        }

        MessageErreur = null;
        test.P0 = (float)Math.Round(Nu / (1 - Nu) * sigmaz, 0);
        Journal($"P0 = {test.P0} kPa");
    }

    // ================= JOURNAL =================
    private void Journal(string message)
    {
        var ligne = $"[{DateTime.Now:HH:mm:ss.fff}] [NewTest] {message}";
        Console.WriteLine(ligne);
        System.Diagnostics.Debug.WriteLine(ligne);
    }

    // ================= ACTIONS =================
    private Task Valider()
    {
        MessageErreur = null;
        MessageSucces = null;

        if (string.IsNullOrWhiteSpace(test.Reference))
        {
            MessageErreur = "La référence de l'essai est obligatoire.";
            return Task.CompletedTask;
        }

        if (string.IsNullOrWhiteSpace(test.NomEssai))
        {
            MessageErreur = "Le nom de l'essai est obligatoire.";
            return Task.CompletedTask;
        }

        RefEssai = test.Reference;
        MessageSucces = $"Essai {test.Reference} validé en mémoire (non sauvegardé).";
        return Task.CompletedTask;
    }

    private void Annuler() => Navigation.NavigateTo("/");
    private void Fermer() => Navigation.NavigateTo("/");
    private void Modifier() => Journal("Mode modification");
    private void Supprimer() => Journal("Suppression demandée");
    private void Imprimer() => Journal("Impression");

    private async Task Enregistrer()
    {
        Journal("Enregistrement - début");
        MessageErreur = null;
        MessageSucces = null;

        if (string.IsNullOrWhiteSpace(test.Reference))
        {
            MessageErreur = "La référence de l'essai est obligatoire.";
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var existant = await db.ListeEssaiForageDb
                .FirstOrDefaultAsync(e => e.RefEssai == test.Reference);

            if (existant is null)
            {
                var essai = new Essai_Forage
                {
                    RefEssai = test.Reference,
                    RefChantier = ChantierAssocie,
                    RefForage = RefForage,
                    nomEssai = test.NomEssai,
                    dateEssai = test.DateEssai.ToString("yyyy-MM-dd"),
                    heureEssai = test.HeureEssai.ToString("HH:mm:ss"),
                    Enregistreur = test.Enregistreur,
                    Operateur = test.Operateur,
                    ClassPrecis = test.ClassePrecision switch
                    {
                        "A" => 1,
                        "B" => 2,
                        _ => 3
                    },
                    difPresEauAir = (float)test.DiffPression,
                    hauteurCpv = (float)test.HauteurControleur,
                    presP0 = (float)test.P0,
                    profNappe = (float)test.ProfondeurNappe,
                    profSonde = (float)test.ProfondeurSonde,
                    poidsVol = (float)test.PoidsVolumique,
                    poidsVolDejauge = (float)test.PoidsVolumiqueDejauge,
                    coefPoisson = (float)test.CoefficientPoisson,
                    PrecisVolume = (float)test.PrecisionVolume,
                    PrecisPression = (float)test.PrecisionPression
                };
                db.ListeEssaiForageDb.Add(essai);
            }
            else
            {
                existant.nomEssai = test.NomEssai;
                existant.dateEssai = test.DateEssai.ToString("yyyy-MM-dd");
                existant.heureEssai = test.HeureEssai.ToString("HH:mm:ss");
                existant.Enregistreur = test.Enregistreur;
                existant.Operateur = test.Operateur;
                existant.difPresEauAir = (float)test.DiffPression;
                existant.hauteurCpv = (float)test.HauteurControleur;
                existant.presP0 = (float)test.P0;
                existant.profNappe = (float)test.ProfondeurNappe;
                existant.profSonde = (float)test.ProfondeurSonde;
                existant.poidsVol = (float)test.PoidsVolumique;
                existant.poidsVolDejauge = (float)test.PoidsVolumiqueDejauge;
                existant.coefPoisson = (float)test.CoefficientPoisson;
            }

            var nb = await db.SaveChangesAsync();
            Journal($"SaveChangesAsync - {nb} ligne(s) écrite(s)");

            MessageSucces = $"Essai {test.Reference} enregistré en base.";
        }
        catch (Exception ex)
        {
            MessageErreur = $"Échec de l'enregistrement : {ex.Message}";
            Journal($"ERREUR : {ex.GetType().Name} - {ex.Message}");
            if (ex.InnerException != null)
                Journal($"  Interne : {ex.InnerException.Message}");
        }

        Journal("Enregistrement - fin");
    }
}