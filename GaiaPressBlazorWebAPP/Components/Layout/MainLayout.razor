@inherits LayoutComponentBase
@implements IDisposable
@inject LocalizationService Loc
@inject AuthService AuthService
@using GaiaPressBlazorWebAPP.Components
@using GaiaPressBlazorWebAPP.Components.Layout
@using GaiaPressBlazorWebAPP.Services

@* Menu principal en haut de l'écran *@

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">@Loc["About"]</a>
        </div>

        <div class="menu-onglets">
            <FileMenu />
            <NavLink href="/Borehole">@Loc["Borehole"]</NavLink>
            <NavLink href="/Test">@Loc["Test"]</NavLink>
            <NavLink href="/Probe">@Loc["Probe"]</NavLink>
            <NavLink href="/Soil">@Loc["Soil"]</NavLink>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    @Loc["UnhandledError"]
    <a href="" class="reload">@Loc["Reload"]</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // Initialiser l'authentification (récupère l'utilisateur depuis localStorage)
        await AuthService.InitializeAsync();

        // S'abonner aux changements d'état d'authentification
        AuthService.OnAuthStateChanged += OnAuthStateChanged;
        Loc.LanguageChanged += StateHasChanged;
    }

    private void OnAuthStateChanged()
    {
        // Rafraîchir l'UI quand l'utilisateur se connecte/déconnecte
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
        Loc.LanguageChanged -= StateHasChanged;
    }
}