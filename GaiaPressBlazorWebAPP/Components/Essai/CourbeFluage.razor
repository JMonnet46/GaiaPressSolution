@* Components/Essai/CourbeFluage.razor *@
@page "/courbe-fluage"

@using GaiaPressCoreV17.Models
@using ChartJs.Blazor
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.Common.Axes
@using ChartJs.Blazor.Common.Axes.Ticks
@using ChartJs.Blazor.Common.Enums
@using ChartJs.Blazor.LineChart

<h3>Courbe de fluage</h3>

<Chart Config="@lineConfig" @ref="lineChart" />

@code {
    [Parameter] public List<double> XValues { get; set; } = new();
    [Parameter] public List<double> YValues { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Fluage (cm³)";
    [Parameter] public double Minimum { get; set; } = 0;
    [Parameter] public double Maximum { get; set; } = 10;
    [Parameter] public int[] BorderDash { get; set; } = new int[] { 0 };
    [Parameter] public int BorderWidth { get; set; } = 1;

    private Chart lineChart;
    private LineConfig lineConfig;

    protected override void OnInitialized()
    {
        lineConfig = new LineConfig
        {
            Options = new LineOptions
            {
                Responsive = true,
                Scales = new Scales
                {
                    XAxes = new List<CartesianAxis>
                    {
                        new LinearCartesianAxis
                        {
                            ScaleLabel = new ScaleLabel { Display = true, LabelString = "Temps (s)" },
                            Ticks = new LinearCartesianTicks { Min = Minimum, Max = Maximum }
                        }
                    },
                    YAxes = new List<CartesianAxis>
                    {
                        new LinearCartesianAxis
                        {
                            ScaleLabel = new ScaleLabel { Display = true, LabelString = Title },
                            Ticks = new LinearCartesianTicks { Min = Minimum, Max = Maximum }
                        }
                    }
                }
            }
        };

        var dataset = new LineDataset<double>(YValues)
        {
            Label = Title,
            Fill = false,
            BorderColor = "#3e95cd",
            BackgroundColor = "rgba(62, 149, 205, 0.1)",
            BorderWidth = BorderWidth,
            BorderDash = BorderDash,
            PointRadius = 3,
            PointHoverRadius = 5,
            LineTension = 0.1
        };

        foreach (var x in XValues)
            lineConfig.Data.Labels.Add(x.ToString());

        lineConfig.Data.Datasets.Add(dataset);
    }
}