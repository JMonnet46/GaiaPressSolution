@* Components/Essai/CourbeFluage.razor *@
@using ChartJs.Blazor.Common
@using ChartJs.Blazor.LineChart
@using ChartJs.Blazor.Common.Axes

<h3>Courbe de fluage</h3>

<Chart Config="@ChartConfig" />

@code {
    [Parameter]
    public List<double> XValues { get; set; } = new List<double>();

    [Parameter]
    public List<double> YValues { get; set; } = new List<double>();

    [Parameter]
    public string Title { get; set; } = "Fluage (cm³)";

    [Parameter]
    public double Minimum { get; set; } = 0;

    [Parameter]
    public double Maximum { get; set; } = 10;

    [Parameter]
    public double[] BorderDash { get; set; } = new double[] { 0 }; // Équivalent à Solid

    [Parameter]
    public int BorderWidth { get; set; } = 1;

    private LineConfig ChartConfig { get; set; }

    protected override void OnInitialized()
    {
        ChartConfig = new LineConfig
        {
            Options = new LineOptions
            {
                Responsive = true,
                Scales = new Scales
                {
                    X = new LinearScale
                    {
                        Title = new ChartTitle { Display = true, Text = "Temps (s)" },
                        Min = Minimum,
                        Max = Maximum
                    },
                    Y = new LinearScale
                    {
                        Title = new ChartTitle { Display = true, Text = Title },
                        Min = Minimum,
                        Max = Maximum
                    }
                },
                Elements = new LineElements
                {
                    Line = new LineElement
                    {
                        BorderDash = BorderDash, // Équivalent à .LineDashStyle
                        BorderWidth = BorderWidth,
                        Tension = 0.1
                    }
                }
            }
        };

        // Ajouter les données au graphique
        var dataset = new LineDataset<double>(YValues)
        {
            Label = Title,
            Fill = false,
            BorderColor = "#3e95cd",
            BackgroundColor = "rgba(62, 149, 205, 0.1)",
            PointRadius = 3,
            PointHoverRadius = 5
        };

        ChartConfig.Data.Labels = XValues.Select(x => x.ToString()).ToList();
        ChartConfig.Data.Datasets = new List<LineDataset<double>> { dataset };
    }
}