<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>42d54601-0780-413c-a9c0-198d75a4f5df</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Migrations\GaiaPressDb\**" />
    <Compile Remove="wwwroot\css\**" />
    <Content Remove="Migrations\GaiaPressDb\**" />
    <Content Remove="wwwroot\css\**" />
    <EmbeddedResource Remove="Migrations\GaiaPressDb\**" />
    <EmbeddedResource Remove="wwwroot\css\**" />
    <None Remove="Migrations\GaiaPressDb\**" />
    <None Remove="wwwroot\css\**" />
  </ItemGroup>

  <!-- Suppression des fichiers inutiles -->
  <ItemGroup>
    <Compile Remove="Components\Account\IdentityComponentsEndpointRouteBuilderExtensions.cs" />
    <Compile Remove="Data\GaiaPressDbContext.cs" />
    <Compile Remove="Data\GaiaPressDbContextV0.cs" />
    <Compile Remove="Models\Forage.cs" />
    <Content Remove="Components\Account\Pages\ExternalLogin.razor" />
    <Content Remove="Components\Pages\Auth.razor" />
    <Content Remove="Components\Test\NewTest - Bakup.razor" />
    <Content Remove="wwwroot\WebChantier.vb" />
  </ItemGroup>

  <!-- Configuration correcte du DbContext -->
  <ItemGroup>
    <None Remove="Data\GaiaPressDbContext.cs" />
  </ItemGroup>

  <!-- Références aux packages CORRECTES -->
  <ItemGroup>
    <!-- Core Identity & EF Core -->
    <PackageReference Include="ChartJs.Blazor" Version="1.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.11" />

    <!-- EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <!-- Azure (si utilisé) -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />

    <!-- Blazor -->
    <PackageReference Include="ChartJs.Blazor.Fork" Version="2.0.2" />

    <!-- JS Interop pour .NET 8 -->
    <PackageReference Include="Microsoft.JSInterop" Version="8.0.11" />
  </ItemGroup>

  <!-- Référence au projet VB.NET (à vérifier) -->
  <ItemGroup>
    <ProjectReference Include="..\GaiaPressCoreV17\GaiaPressCoreV17.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>