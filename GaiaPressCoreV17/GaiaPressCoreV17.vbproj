<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Language>VB</Language>
        <UserSecretsId>8cd7467b-65f2-48d7-9600-087c5217cb82</UserSecretsId>
        <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
        <OutputType>Library</OutputType>
        <RootNamespace />
    </PropertyGroup>

    <PropertyGroup>
        <NoWarn>$(NoWarn);SLL0001</NoWarn>
	<EnableDefaultCompileItems>false</EnableDefaultCompileItems>    
    </PropertyGroup>

    <PropertyGroup>
        <SixLaborsLicenseFile>sixlabors.lic</SixLaborsLicenseFile>
    </PropertyGroup>

    <PropertyGroup>
       <GenerateReferenceAssemblyOnBuild>true</GenerateReferenceAssemblyOnBuild>
       <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <!-- Packages NuGet compatibles avec .NET 8.0 -->
        <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
        <PackageReference Include="Azure.Identity" Version="1.21.0" />
        <PackageReference Include="itext" Version="8.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.12" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.0" />
        <PackageReference Include="NuGet.Common" Version="6.3.4" />
        <PackageReference Include="PdfSharpCore" Version="1.3.67" />
        <PackageReference Include="QuestPDF" Version="2026.6.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12-pre20260709125052" />
        <PackageReference Include="NuGet.Protocol" Version="6.3.3" />
        <PackageReference Include="NuGet.Packaging" Version="6.3.4" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.6.0-preview3.19128.7" />
        <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
        <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
        <PackageReference Include="System.Formats.Asn1" Version="9.0.0" />
    </ItemGroup>

    <!-- Suppression des fichiers inutiles -->
    <ItemGroup>
        <Compile Remove="Program.vb" />
        <Compile Remove="CHANGELOG_GaiaPress.md\**" />
        <Compile Remove="Datas\**" />
        <Compile Remove="Data\**" />
        <Compile Remove="Models\**" />
        <Compile Remove="Service\**" />
        <Content Remove="CHANGELOG_GaiaPress.md\**" />
        <Content Remove="Data\**" />
        <Content Remove="Models\**" />
        <Content Remove="Service\**" />
        <EmbeddedResource Remove="CHANGELOG_GaiaPress.md\**" />
        <EmbeddedResource Remove="Datas\**" />
        <EmbeddedResource Remove="Data\**" />
        <EmbeddedResource Remove="Models\**" />
        <EmbeddedResource Remove="Service\**" />
        <None Remove="CHANGELOG_GaiaPress.md\**" />
        <None Remove="Datas\**" />
        <None Remove="Data\**" />
        <None Remove="Models\**" />
        <None Remove="Service\**" />
    </ItemGroup>

    <!-- Fichiers à inclure -->
    <ItemGroup>
        <Compile Include="Data\DesignTimeDbContextFactory.vb" />
        <Compile Include="Data\GaiaPressDbContext.vb" />
        <Compile Include="Logic\ChantierLogic.vb" />
        <Compile Include="Logic\EssaiExpansionLogic.vb" />
        <Compile Include="Logic\EssaiForageLogic.vb" />
        <Compile Include="Logic\EssaiResistanceLogic.vb" />
        <Compile Include="Logic\ForageLogic.vb" />
        <Compile Include="Logic\MesuresEssaisForageLogic.vb" />
        <Compile Include="Logic\SolsLogic.vb" />
        <Compile Include="Logic\SondeLogic.vb" />

        <!-- Modèles -->
        <Compile Include="Models\ClasseChantier.vb" />
        <Compile Include="Models\ClasseEssaiExpansion.vb" />
        <Compile Include="Models\ClasseEssaiForage.vb" />
        <Compile Include="Models\ClasseEssaiResistance.vb" />
        <Compile Include="Models\ClasseForage.vb" />
        <Compile Include="Models\ClasseListeChantier.vb" />
        <Compile Include="Models\ClasseListeEssaiForage.vb" />
        <Compile Include="Models\ClasseListeExpansion.vb" />
        <Compile Include="Models\ClasseListeForage.vb" />
        <Compile Include="Models\ClasseListeMesureEssaiForage.vb" />
        <Compile Include="Models\ClasseListeMesureExpansion.vb" />
        <Compile Include="Models\ClasseListeMesureResistance.vb" />
        <Compile Include="Models\ClasseListeResistance.vb" />
        <Compile Include="Models\ClasseListeSol.vb" />
        <Compile Include="Models\ClasseListeSonde.vb" />
        <Compile Include="Models\ClasseMesureEssaiForage.vb" />
        <Compile Include="Models\ClasseMesureExpansion.vb" />
        <Compile Include="Models\ClasseMesureResistance.vb" />
        <Compile Include="Models\ClasseModuleElasticite.vb" />
        <Compile Include="Models\ClasseProbe.vb" />
        <Compile Include="Models\ClasseSol.vb" />
        <!-- ... (autres fichiers Models) ... -->

        <!-- DTOs -->
        <Compile Include="Models\Dto\ChantierDto.vb" />
        <Compile Include="Models\Dto\EssaiExpansionDto.vb" />
        <Compile Include="Models\Dto\EssaiForageDto.vb" />
        <Compile Include="Models\Dto\EssaiPerteDeChargeDto.vb" />
        <Compile Include="Models\Dto\EssaiResistanceDto.vb" />
        <Compile Include="Models\Dto\ForageDto.vb" />
        <Compile Include="Models\Dto\MesureEssaiForageDto.vb" />
        <Compile Include="Models\Dto\MesureExpansionDto.vb" />
        <Compile Include="Models\Dto\MesurePerteDeChargeDto.vb" />
        <Compile Include="Models\Dto\MesureResistanceDto.vb" />
        <Compile Include="Models\Dto\PrecisionElastDto.vb" />
        <Compile Include="Models\Dto\SolDto.vb" />
        <Compile Include="Models\Dto\SondeDto.vb" />
        <Compile Include="Models\ForageEntity.vb" />
        <Compile Include="Models\ScreenCapture.vb" />
        <Compile Include="Models\ScreenShotModel.vb" />
        <Compile Include="Services\ChantierService.vb" />
        <Compile Include="Services\DataBaseConnexion.vb" />
        <Compile Include="Services\DataBaseReadService.vb" />
        <Compile Include="Services\DataBaseWriteService.vb" />
        <Compile Include="Services\DataService.vb" />
        <Compile Include="Services\EssaiExpansionService.vb" />
        <Compile Include="Services\EssaiForageService.vb" />
        <Compile Include="Services\EssaiResistanceService.vb" />
        <Compile Include="Services\ForageService.vb" />
        <Compile Include="Services\MesuresEssaisForageService.vb" />
        <Compile Include="Services\MesuresExpansionService.vb" />
        <Compile Include="Services\MesuresResistanceService.vb" />
        <Compile Include="Services\ModBibliotheque.vb" />
        <Compile Include="Services\ModCohesion.vb" />
        <Compile Include="Services\ModComportPressio.vb" />
        <Compile Include="Services\ModDilatance.vb" />
        <Compile Include="Services\ModFrottement.vb" />
        <Compile Include="Services\ModLectureFichExcel.vb" />
        <Compile Include="Services\ModMath.vb" />
        <Compile Include="Services\ModMoyVar.vb" />
        <Compile Include="Services\ModOptimisation.vb" />
        <Compile Include="Services\ModPresLanterne.vb" />
        <Compile Include="Services\ModPressionlimite.vb" />
        <Compile Include="Services\ModPressionNF.vb" />
        <Compile Include="Services\ModPresSondeNue.vb" />
        <Compile Include="Services\ModRegresLine.vb" />
        <Compile Include="Services\ModStatProba.vb" />
        <Compile Include="Services\ModTrigo.vb" />
        <Compile Include="Services\SolsService.vb" />
        <Compile Include="Services\SondeService.vb" />
        <!-- ... (autres fichiers DTO) ... -->
    </ItemGroup>

    <!-- Dossiers -->
    <ItemGroup>
        <Folder Include="GaiaPressForm\Image\" />
        <Folder Include="GaiaPressForm\Stryle\" />
        <Folder Include="Utilities\" />
    </ItemGroup>

    <!-- Fichiers divers -->
    <ItemGroup>
        <None Include="Data\GaiaPressSchema.sql" />
    </ItemGroup>
</Project>