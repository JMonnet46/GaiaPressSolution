<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Language>VB</Language>
		<UserSecretsId>8cd7467b-65f2-48d7-9600-087c5217cb82</UserSecretsId>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<!-- ✅ Supprimez ou corrigez cette section -->
		<!-- <ImportedNamespaces>
                <EnableDefaultContentItems>false</EnableDefaultContentItems>
                <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
      GaiaPressCoreV17.Models=False,
      GaiaPressCoreV17.Service=False,
      Microsoft.VisualBasic=True,
      System=True,
      System.Collections=True,
      System.Collections.Generic=True,
      System.Diagnostics=True,
      System.Linq=True,
      System.Xml.Linq=True,
      System.Threading.Tasks=True,
      GaiaPressCoreV17=True
    </ImportedNamespaces> -->
		<OutputType>Library</OutputType>
		<!-- <AssemblyName>$MSBuildProjectName$</AssemblyName> -->
		<RootNamespace />
	</PropertyGroup>
	<PropertyGroup>
		<NoWarn>$(NoWarn);SLL0001</NoWarn>
	</PropertyGroup>
	<PropertyGroup>
		<SixLaborsLicenseFile>sixlabors.lic</SixLaborsLicenseFile>
	</PropertyGroup>
	<ItemGroup>
    <!-- Packages NuGet compatibles avec .NET 8.0 -->
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="itext" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.12" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="8.0.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="8.0.0" />
    <PackageReference Include="NuGet.Common" Version="6.3.4" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QuestPDF" Version="2026.6.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.6" />
    <!-- Promoted transitive dependency to address vulnerabilities -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12-pre20260709125052" />
    <!-- NuGet libraries promoted as direct references to ensure safe versions -->
    <PackageReference Include="NuGet.Protocol" Version="6.3.3" />
    <PackageReference Include="NuGet.Packaging" Version="6.3.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.6.0-preview3.19128.7" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.Formats.Asn1" Version="9.0.0" />
  </ItemGroup>

  <!-- Suppression des fichiers non nécessaires -->
  <ItemGroup>
    <Compile Remove="CHANGELOG_GaiaPress.md\**" />
    <Compile Remove="Datas\**" />
    <Compile Remove="Data\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Service\**" />
    <Content Remove="CHANGELOG_GaiaPress.md\**" />
    <Content Remove="Data\**" />
    <Content Remove="Models\**" />
    <Content Remove="Service\**" />
    <EmbeddedResource Remove="CHANGELOG_GaiaPress.md\**" />
    <EmbeddedResource Remove="Datas\**" />
    <EmbeddedResource Remove="Data\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Service\**" />
    <None Remove="CHANGELOG_GaiaPress.md\**" />
    <None Remove="Datas\**" />
    <None Remove="Data\**" />
    <None Remove="Models\**" />
    <None Remove="Service\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Program.vb" />
  </ItemGroup>
  <ItemGroup>
